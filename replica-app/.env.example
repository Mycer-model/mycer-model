# Copy to .env.local and fill in your own values. Never commit real keys.
# Supabase (create the project yourself)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never in client code
DATABASE_URL=
# Stripe (TEST mode keys until deploy)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
STRIPE_PRICE_TOPUP_1000=
# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
# Generation provider (chosen by you; the mock provider is used when empty)
GENERATION_PROVIDER=
GENERATION_PROVIDER_API_KEY=
# Jobs (Inngest)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
